  * frames go in through wl_rx_msdu; between them the thread sleeps until
  * the chip interrupts (wl_idle), or polls every 1 ms without interrupts.
  */
+/*
+ * Firmware crash while running (FW_IND bit 0, as ath10k_pci_fw_crashed_dump):
+ * register dump from hi_failure_state, link down for iOS, then stages 2 and 3
+ * again (cold reset, firmware download, HTC/WMI) and a scan, so wifid sees
+ * networks again. At most 3 times per boot.
+ */
+static uint32_t wl_recoveries;
+
+static bool
+wl_fw_recover(void)
+{
+	uint32_t fs = 0;
+	printf("SAILFISH WLAN: FIRMWARE CRASHED while running (fw_ind %#x, rtc %#x, %d tx slots held, tx id %u), recovery %u\n",
+	    rd(wl_bar, Q_FW_IND), rd(wl_bar, Q_RTC_STATE), __builtin_popcount(wl_slot_busy), wl_tx_id, wl_recoveries + 1);
+	if (wl_diag_read32(HI(0x04), &fs) && fs) {
+		uint32_t w[60] = { 0 };
+		for (int i = 0; i < 60 && wl_diag_read32(fs + 4 * i, &w[i]); i++) {
+		}
+		printf("SAILFISH WLAN: crash dump at %#x:\n", fs);
+		for (int i = 0; i < 60; i += 6) {
+			printf("SAILFISH WLAN: crash[%02d] %08x %08x %08x %08x %08x %08x\n", i, w[i], w[i + 1], w[i + 2], w[i + 3], w[i + 4], w[i + 5]);
+		}
+	} else {
+		printf("SAILFISH WLAN: no crash dump (hi_failure_state unreadable)\n");
+	}
+	sweet_log_kick();
+	wl_ready = false;
+	if (wl_net_up) {
+		wl_link_changed(false, true);
+	}
+	lck_mtx_lock(wl_ifq_lock);                      /* frames for the old association */
+	while (wl_ifq_count) {
+		mbuf_freem(wl_ifq[wl_ifq_head]);
+		wl_ifq_head = (wl_ifq_head + 1) % WL_IFQ;
+		wl_ifq_count--;
+	}
+	lck_mtx_unlock(wl_ifq_lock);
+	if (++wl_recoveries > 3) {
+		printf("SAILFISH WLAN: too many firmware crashes, Wi-Fi stays off until reboot\n");
+		return false;
+	}
+	wl_slot_busy = 0;
+	wl_txc_n = wl_tx_id;
+	if (wl_irq_on) {
+		sweet_spi_mask(WL_IRQ_INTID, true);     /* no handler on the BAR during the cold reset */
+	}
+	bool ok = wl_stage2();
+	ok = ok && wl_stage3();
+	ok = ok && wl_scan();
+	wl_aspm_off("recovered");
+	wl_fast = true;
+	if (ok && wl_irq_on) {
+		wr(wl_bar, ce1.reg + CE_HOST_IE, 1u);
+		wr(wl_bar, ce2.reg + CE_HOST_IE, 1u);
+		sweet_spi_mask(WL_IRQ_INTID, false);
+	}
+	wl_ready = ok;
+	printf("SAILFISH WLAN: firmware recovery %s\n", ok ? "done, scanning again" : "FAILED");
+	sailfish_wlan_iokit_event(A80211_EV_POWER_CHANGED, NULL, 0);
+	sweet_log_kick();
+	return ok;
+}
