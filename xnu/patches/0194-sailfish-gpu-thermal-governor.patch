+
+/*
+ * Thermal governor (boot-arg sweetthermal=0 turns it off, sweettlimit=C sets the first limit, default 72):
+ * the GPU runs at its top clock and steps 600 -> 400 -> 300 -> 200 MHz when the hottest TSENS sensor
+ * passes limit, limit+7, limit+13 C, and back up one step at a time 5 C below each. Frequency goes
+ * down before the voltage does and up after it (gfx_raise), under the VM lock like gfx_raise.
+ */
+static int g_cur_mhz = 300;
+
+static bool
+gfx_volt(uint32_t mv)
+{
+	uint8_t sub = 0;
+	if (!sweet_pmic_read(GFX_S2, 0x05, &sub) || (sub != 8 && sub != 9)) {
+		return false;
+	}
+	return sweet_pmic_write(GFX_S2, 0x41, (uint8_t)((mv - (sub == 9 ? 80 : 0)) / 5));
+}
+
+static bool
+gfx_set_mhz(int mhz)
+{
+	bool ok;
+	if (mhz == g_cur_mhz) {
+		return true;
+	}
+	if (mhz > g_cur_mhz && mhz >= 400) {
+		ok = gfx_raise(mhz);
+	} else if (mhz > g_cur_mhz) {
+		ok = gfx_clock(3);
+	} else {
+		ok = gfx_clock(mhz == 400 ? 2 : mhz == 300 ? 3 : 5);
+		if (ok) {
+			delay(200);
+			(void)gfx_volt(mhz == 400 ? 825 : 745);
+		}
+	}
+	if (ok) {
+		g_cur_mhz = mhz;
+		g_max_mhz = mhz;
+	}
+	return ok;
+}
+
+/* Hottest TSENS sensor in 0.1 C (tsens-v2 TM blocks 0x4a9000 x13 and 0x4ad000 x8, as in sailfish_wlan.c). */
+static int
+gfx_temp(void)
+{
+	static vm_offset_t tm[2];
+	static const uint32_t pa[2] = { 0x4a9000u, 0x4ad000u }, n[2] = { 13, 8 };
+	int max = -1000;
+	for (int b = 0; b < 2; b++) {
+		if (!tm[b]) {
+			tm[b] = ml_io_map(pa[b], 0x1000);
+		}
+		for (uint32_t i = 0; tm[b] && i < n[b]; i++) {
+			uint32_t v = rd(tm[b], 0xa0 + 4 * i);
+			int t = (int)(v & 0xfffu);
+			if (t & 0x800) {
+				t -= 0x1000;
+			}
+			if ((v & (1u << 21)) && t > max) {
+				max = t;
+			}
+		}
+	}
+	return max;
+}
+
+static void
+thermal_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	static const int levels[4] = { 600, 400, 300, 200 };
+	int top = (int)(uintptr_t)arg, limit = 72, idx = top >= 600 ? 0 : 1, min_idx = idx, ticks = 0;
+	(void)PE_parse_boot_argn("sweettlimit", &limit, sizeof(limit));
+	int thr[3] = { limit * 10, (limit + 7) * 10, (limit + 13) * 10 };
+	printf("SWEET THERMAL: governor on, GPU %d MHz down from %d C (%d C: 300, %d C: 200)\n", top, limit, limit + 7, limit + 13);
+	for (;;) {
+		gpu_sleep(1);
+		int t = gfx_temp(), want = idx;
+		if (t < -500) {
+			continue;
+		}
+		if (idx < 3 && t >= thr[idx]) {
+			want = idx + 1;
+		} else if (idx > min_idx && t < thr[idx - 1] - 50 && ticks % 5 == 0) {
+			want = idx - 1;
+		}
+		ticks++;
+		if (want != idx) {
+			lck_mtx_lock(&sweet_gpu_vm_lock);
+			bool ok = gfx_set_mhz(levels[want]);
+			lck_mtx_unlock(&sweet_gpu_vm_lock);
+			printf("SWEET THERMAL: %d.%d C -> GPU %d MHz %s\n", t / 10, t % 10, levels[want], ok ? "ok" : "FAILED (stays)");
+			if (ok) {
+				idx = want;
+			}
+		} else if (ticks % 60 == 0) {
+			printf("SWEET THERMAL: %d.%d C, GPU %d MHz\n", t / 10, t % 10, levels[idx]);
+		}
+	}
+}
 
