+/*
+ * No wait for the IOBSD resource in IONetworkController::start: when IOKit
+ * matched us before BSD was up, that wait never returned (logs/boot17.txt,
+ * boot20.txt: "start" without "started", grayed-out Wi-Fi switch). start()
+ * needs no mbufs; the interface is attached later from the radio thread.
+ */
+UInt32
+SailfishWLAN::getFeatures(void) const
+{
+	return super::getFeatures() | kIONetworkFeatureNoBSDWait;
+}
