 		return false;
 	}
 	sweet_log_kick();
+	wl_cur_ok = false;
+	for (uint32_t i = 0; i < wl_nnets; i++) {
+		if (memcmp(wl_nets[i].bssid, wl_bss.bssid, 6) == 0) {
+			wl_cur = wl_nets[i];
+			wl_cur_ok = true;
+			break;
+		}
+	}
+	if (!wl_cur_ok) {
