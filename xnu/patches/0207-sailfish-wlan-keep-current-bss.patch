+			}
+			if (type == A80211_CURRENT_NETWORK && up) {
+				printf("SAILFISH 80211: CURRENT_NETWORK while connected but no record\n");
+			}
 			for (uint32_t i = type == A80211_SCAN_RESULT ? wl_scan_next : 0; i < wl_nnets; i++) {
