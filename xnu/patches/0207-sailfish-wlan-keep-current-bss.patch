 	uint8_t ie[1024];
 } wl_nets[WL_NETS];
 static uint32_t wl_nnets, wl_scan_next;         /* entries; next one SCAN_RESULT returns */
+/*
+ * The joined network's record, kept from the join's scan. CURRENT_NETWORK
+ * answers from it, and a scan while connected that missed our own AP gets it
+ * added: wifid's post-join scans replace wl_nets, and an AP absent from them
+ * made CURRENT_NETWORK fail while connected (channel 11 AP: never DHCP,
+ * logs/join5,7,10,11; channel 6 AP: DHCP, join6,9).
+ */
+static struct wl_net wl_cur;
+static bool wl_cur_ok;
 static volatile bool wl_scan_req;               /* wifid asked for a scan (SCAN_REQ): wl_run does it */
 
 /* wifid's join / leave / power requests for the Wi-Fi thread (under wl_ifq_lock), and their state. */
@@ -2257,6 +2266,16 @@
 		}
 	}
 	wl_scan_next = 0;
+	if (wl_net_up && wl_cur_ok) {
+		bool have = false;
+		for (unsigned i = 0; i < wl_nnets && !have; i++) {
+			have = memcmp(wl_nets[i].bssid, wl_cur.bssid, 6) == 0;
+		}
+		if (!have && wl_nnets < WL_NETS) {
+			wl_nets[wl_nnets++] = wl_cur;
+		}
+		printf("SAILFISH WLAN: scan while connected: our AP %s\n", have ? "heard" : "not heard, added from the join");
+	}
